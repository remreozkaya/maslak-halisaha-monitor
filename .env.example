# Copy to .env; keep secrets out of source control and ZIPs.
ITU_USERNAME=replace_me
ITU_PASSWORD='replace_me'
DRY_RUN=true
CHECK_INTERVAL=120
NOTIFICATION_CHANNEL=email
EMAIL_RECIPIENTS=first@example.com,second@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sender@gmail.com
# Gmail app password, not your regular Google password.
SMTP_PASSWORD=
PURCHASE_BUTTON_TEXT='Satın Al'
PURCHASE_SELECTOR_VERIFIED=false
# Optional paid SMS compatibility. Not used in email mode.
SMS_RECIPIENTS=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# calendar: notify when next-week dates become selectable; purchase: enabled buy control
AVAILABILITY_MODE=calendar
